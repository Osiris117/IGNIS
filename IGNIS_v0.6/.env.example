# IGNIS v0.6 — configuración de ejemplo
# Copia este archivo a `.env` y ajusta los valores.
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env

# --- NASA FIRMS (obligatorio para datos en vivo / históricos vía API) ---
# MAP_KEY gratuito: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=YOUR_KEY
FIRMS_SOURCE=VIIRS_NOAA21_NRT

# --- Candidate Fire Event clustering (valores por defecto del prototipo) ---
# NO son umbrales oficiales de identificación de incendios.
IGNIS_EVENT_RADIUS_KM=28
IGNIS_EVENT_WINDOW_HOURS=36
IGNIS_EVENT_MIN_POINTS=2

# --- Fire Evolution Engine (v0.7) ---
# Radio de vínculo entre cluster y pista persistente, y separación máxima
# entre observaciones. Valores de prototipo, no umbrales oficiales.
IGNIS_TRACK_MATCH_KM=60
IGNIS_TRACK_MAX_GAP_HOURS=48
IGNIS_TRACK_STATE_DELTA=0.20
# Gap máximo para reutilizar una identidad del registro local (horas).
IGNIS_TRACK_REGISTRY_GAP_HOURS=168

# --- Caché en memoria de respuestas FIRMS (segundos) ---
IGNIS_CACHE_TTL=90

# --- Servidor (usado por start_ignis.py; Dockerfile ya fija 0.0.0.0:8000) ---
IGNIS_HOST=127.0.0.1
IGNIS_PORT=8000
